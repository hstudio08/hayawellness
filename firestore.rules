rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check function
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Public read collections (Departments, Services, Doctors, Health Insights/Blogs, Media)
    match /departments/{department} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /doctors/{doctor} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /doctorSchedules/{schedule} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /scheduleOverrides/{override} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /blogs/{blog} {
      allow read: if true; // Might want to restrict to published only later
      allow write: if isAdmin();
    }
    
    match /media/{mediaItem} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Patients collection (Only admins can read/write)
    match /patients/{patient} {
      allow read, write: if isAdmin();
    }
    
    // Appointments (Public can create, Admins can do everything)
    match /appointments/{appointment} {
      allow read: if isAdmin();
      // Allow creation if the data contains necessary fields. We can add stricter validation later.
      allow create: if true; 
      allow update, delete: if isAdmin();
    }
    
    // Contact Messages (Public can create, Admins can read/delete)
    match /contactMessages/{message} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Admins collection
    match /admins/{adminId} {
      // Only admins can read the admins list
      allow read: if isAdmin();
      // Allow initial admin setup if the collection is empty (optional bootstrapping rule)
      allow write: if isAdmin();
    }
    
    // Settings
    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
